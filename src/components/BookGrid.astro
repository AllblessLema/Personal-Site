---
interface Book {
  title: string;
  author: string;
  isbn: string;
  cover_url?: string;
}

interface Props {
  books: Book[];
}

const { books } = Astro.props;
const base = import.meta.env.BASE_URL;

function toSlug(title: string) {
  return title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}
---

<div class="book-grid">
  {books.map(book => {
    const src = `https://covers.openlibrary.org/b/isbn/${book.isbn}-L.jpg?default=false`;
    const fallback = book.cover_url ?? `${base}covers/${toSlug(book.title)}.jpg`;
    return (
      <div class="book-card">
        <img
          class="book-cover"
          src={src}
          data-fb={fallback}
          alt={book.title}
          loading="lazy"
          onerror={"if(!this.dataset.fell){this.dataset.fell=1;this.src=this.dataset.fb}else{this.onerror=null;this.style.visibility='hidden'}"}
        />
        <p class="book-title">{book.title}</p>
        <p class="book-author">{book.author}</p>
      </div>
    );
  })}
</div>
