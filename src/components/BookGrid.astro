---
interface Book {
  title: string;
  author: string;
  isbn: string;
  cover_url?: string;
}

interface Props {
  books: Book[];
}

const { books } = Astro.props;
const base = import.meta.env.BASE_URL;

function toSlug(title: string) {
  return title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

function resolveUrl(url: string) {
  return url.startsWith('/covers/') ? `${base}${url.slice(1)}` : url;
}
---

<div class="book-list">
  {books.map(book => {
    const hasCoverUrl = !!book.cover_url;
    const src      = hasCoverUrl
      ? resolveUrl(book.cover_url!)
      : `https://covers.openlibrary.org/b/isbn/${book.isbn}-M.jpg?default=false`;
    const fallback = hasCoverUrl
      ? `https://covers.openlibrary.org/b/isbn/${book.isbn}-M.jpg?default=false`
      : `${base}covers/${toSlug(book.title)}.jpg`;
    return (
      <div class="book-row">
        <img
          class="book-cover"
          src={src}
          data-fb={fallback}
          alt={book.title}
          loading="lazy"
          width="110"
          height="165"
          onerror={"if(!this.dataset.fell){this.dataset.fell=1;this.src=this.dataset.fb}else{this.onerror=null;this.style.visibility='hidden'}"}
        />
        <div class="book-info">
          <p class="book-title">{book.title}</p>
          <p class="book-author">{book.author}</p>
        </div>
      </div>
    );
  })}
</div>
