---
interface Props {
  title: string;
  page?: 'home' | 'reading' | 'projects';
}

const { title, page } = Astro.props;
const fullTitle = page ? `${title} — Allbless Lema` : title;

const b = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
</head>
<body>
  <div class="wrapper">
    <header class="site-header">
      <div class="header-row">
        <a href={b} class="site-name">Allbless Lema</a>
        <nav>
          <a href={b} aria-current={page === 'home' ? 'page' : undefined}>Home</a>
          <a href={`${b}reading/`} aria-current={page === 'reading' ? 'page' : undefined}>Reading</a>
          <a href={`${b}projects/`} aria-current={page === 'projects' ? 'page' : undefined}>Projects</a>
        </nav>
      </div>
      <div class="social-row">
        Find me on:
        <a href="https://github.com/AllblessLema" target="_blank" rel="noopener">GitHub</a>
        <!-- TODO: add Twitter link: <a href="https://twitter.com/..." target="_blank" rel="noopener">Twitter</a> -->
        <a href="https://substack.com/@allblesslema" target="_blank" rel="noopener">Substack</a>
        <!-- TODO: add email: <a href="mailto:...">Email</a> -->
      </div>
    </header>
    <main>
      <slot />
    </main>
  </div>
</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  * { margin: 0; padding: 0; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.65;
    color: #111;
    background: #fff;
  }

  .wrapper {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Header */
  .site-header {
    padding: 1.75rem 0 1.2rem;
    border-bottom: 1px solid #ddd;
    margin-bottom: 2.5rem;
  }

  .header-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-bottom: 0.4rem;
  }

  .site-name {
    font-weight: 600;
    font-size: 0.95rem;
    color: #111;
    text-decoration: none;
  }

  nav a {
    font-size: 0.88rem;
    color: #666;
    text-decoration: none;
    margin-left: 1.4rem;
  }

  nav a:first-child { margin-left: 0; }
  nav a:hover { color: #111; }
  nav a[aria-current="page"] {
    color: #111;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .social-row {
    font-size: 0.78rem;
    color: #999;
  }

  .social-row a {
    color: #999;
    text-decoration: none;
    margin-left: 0.5rem;
  }

  .social-row a:hover { color: #111; }

  /* Typography */
  h1 { font-size: 1rem; font-weight: 600; margin-bottom: 0.6rem; }
  h2 { font-size: 0.95rem; font-weight: 600; margin: 2rem 0 0.6rem; }
  h3 { font-size: 0.9rem; font-weight: 600; margin: 1.75rem 0 0.5rem; }
  h4 { font-size: 0.85rem; font-weight: 600; margin: 1.25rem 0 0.4rem; }

  p { margin-bottom: 0.75rem; }
  p:last-child { margin-bottom: 0; }
  ul { padding-left: 1.5rem; margin-bottom: 0.75rem; }
  li { margin-bottom: 0.3rem; }
  a { color: #111; }
  a:hover { opacity: 0.6; }
  strong { font-weight: 600; }
  em { font-style: italic; }
  code { font-family: ui-monospace, "Courier New", monospace; font-size: 0.9em; }

  /* Book grid */
  .book-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin: 0.75rem 0 1.5rem;
  }

  .book-cover {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    background: #f2f2f2;
    border: 1px solid #e8e8e8;
    display: block;
  }

  .book-title {
    font-size: 0.77rem;
    font-weight: 600;
    margin-top: 0.4rem;
    line-height: 1.3;
    color: #111;
  }

  .book-author {
    font-size: 0.71rem;
    color: #888;
    margin-top: 0.1rem;
  }

  /* Reading two-column layout */
  .reading-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .books-col .book-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  /* Projects index */
  .project-item {
    padding: 0 0 2rem;
    border-bottom: 1px solid #eee;
    margin-bottom: 2rem;
  }

  .project-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
    margin-bottom: 0;
  }

  .project-item h2 { margin-top: 0; }

  .project-item p { color: #333; font-size: 0.95rem; }

  .read-more {
    display: inline-block;
    margin-top: 0.4rem;
    font-size: 0.85rem;
    color: #666;
    text-decoration: none;
  }

  .read-more:hover { color: #111; opacity: 1; }

  /* Project detail page */
  .project-content h2 { margin-top: 2.5rem; }
  .project-content h3 { margin-top: 2rem; }
  .project-content ul { margin-top: 0.25rem; }

  /* Checklist (books to read) */
  .checklist {
    list-style: none;
    padding: 0;
  }

  .checklist li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.35rem 0;
    font-size: 0.9rem;
  }

  .checklist input[type="checkbox"] {
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .reading-layout { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .header-row { flex-direction: column; gap: 0.4rem; }
    nav a { margin-left: 0; margin-right: 1rem; }
    nav a:first-child { margin-right: 1rem; }
    .book-grid { grid-template-columns: repeat(2, 1fr); }
    .books-col .book-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
