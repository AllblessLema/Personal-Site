---
interface Props {
  title: string;
  page?: 'home' | 'reading' | 'projects';
  description?: string;
}

const DEFAULT_DESCRIPTION = "Allbless Lema — computer engineering student building hardware accelerators and ML systems from the ground up.";

const { title, page, description = DEFAULT_DESCRIPTION } = Astro.props;
const fullTitle = (page && title !== 'Allbless Lema') ? `${title} — Allbless Lema` : title;

const b = import.meta.env.BASE_URL;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
</head>
<body>
  <div class="wrapper">
    <header class="site-header">
      <div class="header-row">
        <a href={b} class="site-name">Allbless Lema</a>
        <nav>
          <a href={b} aria-current={page === 'home' ? 'page' : undefined}>Home</a>
          <a href={`${b}reading/`} aria-current={page === 'reading' ? 'page' : undefined}>Reading</a>
          <a href={`${b}projects/`} aria-current={page === 'projects' ? 'page' : undefined}>Projects</a>
        </nav>
      </div>
      <div class="social-row">
        Find me on:
        <a href="https://github.com/AllblessLema" target="_blank" rel="noopener">GitHub</a>
        <!-- TODO: add Twitter link: <a href="https://twitter.com/..." target="_blank" rel="noopener">Twitter</a> -->
        <a href="https://substack.com/@allblesslema" target="_blank" rel="noopener">Substack</a>
        <a href="https://www.linkedin.com/in/allbless-lema-1487092a5/" target="_blank" rel="noopener">LinkedIn</a>
        <!-- TODO: add email: <a href="mailto:...">Email</a> -->
      </div>
    </header>
    <main>
      <slot />
    </main>
  </div>
</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  * { margin: 0; padding: 0; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.65;
    color: #111;
    background: #fff;
  }

  .wrapper {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Header */
  .site-header {
    padding: 1.75rem 0 1.2rem;
    border-bottom: 1px solid #ddd;
    margin-bottom: 2.5rem;
  }

  .header-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-bottom: 0.4rem;
  }

  .site-name {
    font-weight: 600;
    font-size: 0.95rem;
    color: #111;
    text-decoration: none;
  }

  nav a {
    font-size: 0.88rem;
    color: #666;
    text-decoration: none;
    margin-left: 1.4rem;
  }

  nav a:first-child { margin-left: 0; }
  nav a:hover { color: #111; }
  nav a[aria-current="page"] {
    color: #111;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .social-row {
    font-size: 0.78rem;
    color: #999;
  }

  .social-row a {
    color: #999;
    text-decoration: none;
    margin-left: 0.5rem;
  }

  .social-row a:hover { color: #111; }

  /* Typography */
  h1 { font-size: 1.7rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 1rem; }
  h2 { font-size: 1.2rem; font-weight: 700; margin: 2.75rem 0 0.75rem; }
  h3 { font-size: 1.02rem; font-weight: 600; margin: 1.9rem 0 0.5rem; }
  h4 { font-size: 0.9rem; font-weight: 600; color: #444; margin: 1.25rem 0 0.4rem; }

  p { margin-bottom: 0.75rem; max-width: 70ch; }
  p:last-child { margin-bottom: 0; }
  ul { padding-left: 1.5rem; margin-bottom: 0.75rem; max-width: 70ch; }
  li { margin-bottom: 0.3rem; }
  a { color: #111; }
  a:hover { opacity: 0.6; }
  strong { font-weight: 600; }
  em { font-style: italic; }
  code { font-family: ui-monospace, "Courier New", monospace; font-size: 0.9em; }

  /* Book list */
  .book-list {
    display: flex;
    flex-direction: column;
    margin: 0.75rem 0 1.5rem;
  }

  .book-row {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid #eee;
  }

  .book-list .book-row:last-child {
    border-bottom: none;
  }

  .book-cover {
    flex: 0 0 auto;
    width: 110px;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    background: #f2f2f2;
    border: 1px solid #e8e8e8;
    display: block;
  }

  .book-info {
    min-width: 0;
  }

  .book-title {
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.35;
    color: #111;
  }

  .book-author {
    font-size: 0.95rem;
    color: #888;
    margin-top: 0.3rem;
  }

  /* Projects index */
  .project-item {
    padding: 0 0 2rem;
    border-bottom: 1px solid #eee;
    margin-bottom: 2rem;
  }

  .project-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
    margin-bottom: 0;
  }

  .project-item h2 { margin-top: 0; }

  .project-item p { color: #333; font-size: 0.95rem; }

  .read-more {
    display: inline-block;
    margin-top: 0.4rem;
    font-size: 0.85rem;
    color: #666;
    text-decoration: none;
  }

  .read-more:hover { color: #111; opacity: 1; }

  /* Project detail page */
  .project-content h2 { margin-top: 2.5rem; }
  .project-content h3 { margin-top: 2rem; }
  .project-content ul { margin-top: 0.25rem; }

  .pg-subtitle {
    font-size: 1.1rem;
    font-weight: 500;
    color: #444;
    margin: -0.5rem 0 0.3rem;
    max-width: 70ch;
  }

  .pg-subtitle a { text-decoration: underline; text-underline-offset: 2px; }

  .pg-dateline {
    font-size: 0.8rem;
    color: #999;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 1.25rem;
  }

  .pg-callout {
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.5;
    color: #111;
    max-width: 38ch;
    margin: 1.25rem 0 1.75rem;
  }

  /* Project stat tiles + repo links (parameter golf, etc.) */
  .pg-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin: 1.5rem 0;
  }

  .pg-stat {
    flex: 1 1 120px;
    padding: 0.9rem 1rem;
    border: 1px solid #e8e8e8;
    border-radius: 8px;
    text-align: center;
    opacity: 0;
    animation: pg-fade-up 0.5s ease forwards;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .pg-stat:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
    border-color: #ccc;
  }

  .pg-stat strong {
    display: block;
    font-size: 1.25rem;
    font-weight: 700;
    color: #111;
  }

  .pg-stat span {
    display: block;
    font-size: 0.7rem;
    color: #888;
    margin-top: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pg-stat:nth-child(1) { animation-delay: 0s; }
  .pg-stat:nth-child(2) { animation-delay: 0.08s; }
  .pg-stat:nth-child(3) { animation-delay: 0.16s; }
  .pg-stat:nth-child(4) { animation-delay: 0.24s; }

  @keyframes pg-fade-up {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .pg-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 0 1.5rem;
  }

  .pg-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid #111;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    color: #111;
    transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .pg-link:hover {
    background: #111;
    color: #fff;
    opacity: 1;
    transform: translateY(-1px);
  }

  .pg-link--ghost {
    border-color: #ccc;
    color: #555;
  }

  .pg-link--ghost:hover {
    background: #555;
    border-color: #555;
  }

  /* Charts and figures (parameter golf, etc.) */
  .pg-hero {
    margin: 1.5rem 0;
  }

  .pg-hero img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid #eee;
    border-radius: 8px;
  }

  .pg-hero--sm img {
    width: 70%;
    margin: 0 auto;
  }

  .pg-chart {
    margin: 1.5rem 0;
    padding: 1rem 1.1rem;
    border: 1px solid #eee;
    border-radius: 8px;
    background: #fafafa;
  }

  .pg-chart img {
    width: 100%;
    height: auto;
    display: block;
  }

  .pg-hero figcaption,
  .pg-chart figcaption {
    font-size: 0.78rem;
    color: #888;
    margin-top: 0.7rem;
  }

  .pg-hero figcaption code,
  .pg-chart figcaption code {
    font-size: 0.95em;
  }

  .pg-iframe-wrap {
    margin: 1.5rem 0;
    border: 1px solid #eee;
    border-radius: 8px;
    overflow: hidden;
  }

  .pg-iframe-wrap iframe {
    width: 100%;
    height: 520px;
    border: 0;
    display: block;
  }

  .project-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0 1.5rem;
    font-size: 0.85rem;
  }

  .project-content th,
  .project-content td {
    text-align: left;
    padding: 0.4rem 0.7rem;
    border-bottom: 1px solid #eee;
    font-family: ui-monospace, "Courier New", monospace;
    font-size: 0.82rem;
  }

  .project-content th {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    font-weight: 600;
    color: #666;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Responsive */
  @media (max-width: 600px) {
    .header-row { flex-direction: column; gap: 0.4rem; }
    nav a { margin-left: 0; margin-right: 1rem; }
    nav a:first-child { margin-right: 1rem; }
    .book-cover { width: 70px; }
    .book-title { font-size: 1.05rem; }
    .pg-stat { flex-basis: 40%; }
    .pg-iframe-wrap iframe { height: 420px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pg-stat {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
