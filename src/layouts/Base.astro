---
interface Props {
  title: string;
  page?: 'home' | 'reading' | 'projects';
}

const { title, page } = Astro.props;
const fullTitle = page ? `${title} — Allbless Lema` : title;

const b = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
</head>
<body>
  <div class="wrapper">
    <header class="site-header">
      <div class="header-row">
        <a href={b} class="site-name">Allbless Lema</a>
        <nav>
          <a href={b} aria-current={page === 'home' ? 'page' : undefined}>Home</a>
          <a href={`${b}reading/`} aria-current={page === 'reading' ? 'page' : undefined}>Reading</a>
          <a href={`${b}projects/`} aria-current={page === 'projects' ? 'page' : undefined}>Projects</a>
        </nav>
      </div>
      <div class="social-row">
        Find me on:
        <a href="https://github.com/AllblessLema" target="_blank" rel="noopener">GitHub</a>
        <!-- TODO: add Twitter link: <a href="https://twitter.com/..." target="_blank" rel="noopener">Twitter</a> -->
        <a href="https://substack.com/@allblesslema" target="_blank" rel="noopener">Substack</a>
        <!-- TODO: add email: <a href="mailto:...">Email</a> -->
      </div>
    </header>
    <main>
      <slot />
    </main>
  </div>
</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  * { margin: 0; padding: 0; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.65;
    color: #111;
    background: #fff;
  }

  .wrapper {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Header */
  .site-header {
    padding: 1.75rem 0 1.2rem;
    border-bottom: 1px solid #ddd;
    margin-bottom: 2.5rem;
  }

  .header-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-bottom: 0.4rem;
  }

  .site-name {
    font-weight: 600;
    font-size: 0.95rem;
    color: #111;
    text-decoration: none;
  }

  nav a {
    font-size: 0.88rem;
    color: #666;
    text-decoration: none;
    margin-left: 1.4rem;
  }

  nav a:first-child { margin-left: 0; }
  nav a:hover { color: #111; }
  nav a[aria-current="page"] {
    color: #111;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .social-row {
    font-size: 0.78rem;
    color: #999;
  }

  .social-row a {
    color: #999;
    text-decoration: none;
    margin-left: 0.5rem;
  }

  .social-row a:hover { color: #111; }

  /* Typography */
  h1 { font-size: 1rem; font-weight: 600; margin-bottom: 0.6rem; }
  h2 { font-size: 0.95rem; font-weight: 600; margin: 2rem 0 0.6rem; }
  h3 { font-size: 0.9rem; font-weight: 600; margin: 1.75rem 0 0.5rem; }
  h4 { font-size: 0.85rem; font-weight: 600; margin: 1.25rem 0 0.4rem; }

  p { margin-bottom: 0.75rem; }
  p:last-child { margin-bottom: 0; }
  ul { padding-left: 1.5rem; margin-bottom: 0.75rem; }
  li { margin-bottom: 0.3rem; }
  a { color: #111; }
  a:hover { opacity: 0.6; }
  strong { font-weight: 600; }
  em { font-style: italic; }
  code { font-family: ui-monospace, "Courier New", monospace; font-size: 0.9em; }

  /* Book grid */
  .book-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin: 0.75rem 0 1.5rem;
  }

  .book-cover {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    background: #f2f2f2;
    border: 1px solid #e8e8e8;
    display: block;
  }

  .book-title {
    font-size: 0.77rem;
    font-weight: 600;
    margin-top: 0.4rem;
    line-height: 1.3;
    color: #111;
  }

  .book-author {
    font-size: 0.71rem;
    color: #888;
    margin-top: 0.1rem;
  }

  /* Projects index */
  .project-item {
    padding: 0 0 2rem;
    border-bottom: 1px solid #eee;
    margin-bottom: 2rem;
  }

  .project-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
    margin-bottom: 0;
  }

  .project-item h2 { margin-top: 0; }

  .project-item p { color: #333; font-size: 0.95rem; }

  .read-more {
    display: inline-block;
    margin-top: 0.4rem;
    font-size: 0.85rem;
    color: #666;
    text-decoration: none;
  }

  .read-more:hover { color: #111; opacity: 1; }

  /* Project detail page */
  .project-content h2 { margin-top: 2.5rem; }
  .project-content h3 { margin-top: 2rem; }
  .project-content ul { margin-top: 0.25rem; }

  /* Project stat tiles + repo links (parameter golf, etc.) */
  .pg-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin: 1.5rem 0;
  }

  .pg-stat {
    flex: 1 1 120px;
    padding: 0.9rem 1rem;
    border: 1px solid #e8e8e8;
    border-radius: 8px;
    text-align: center;
    opacity: 0;
    animation: pg-fade-up 0.5s ease forwards;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .pg-stat:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
    border-color: #ccc;
  }

  .pg-stat strong {
    display: block;
    font-size: 1.25rem;
    font-weight: 700;
    color: #111;
  }

  .pg-stat span {
    display: block;
    font-size: 0.7rem;
    color: #888;
    margin-top: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pg-stat:nth-child(1) { animation-delay: 0s; }
  .pg-stat:nth-child(2) { animation-delay: 0.08s; }
  .pg-stat:nth-child(3) { animation-delay: 0.16s; }
  .pg-stat:nth-child(4) { animation-delay: 0.24s; }

  @keyframes pg-fade-up {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .pg-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 0 1.5rem;
  }

  .pg-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid #111;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    color: #111;
    transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .pg-link:hover {
    background: #111;
    color: #fff;
    opacity: 1;
    transform: translateY(-1px);
  }

  .pg-link--ghost {
    border-color: #ccc;
    color: #555;
  }

  .pg-link--ghost:hover {
    background: #555;
    border-color: #555;
  }

  /* Illustrative diagrams */
  .pg-diagram {
    margin: 1.5rem 0;
    padding: 1.1rem 1.25rem 1.25rem;
    border: 1px solid #eee;
    border-radius: 8px;
    background: #fafafa;
  }

  .pg-diagram-title {
    font-size: 0.75rem;
    font-weight: 600;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.85rem;
  }

  .pg-diagram-caption {
    font-size: 0.78rem;
    color: #888;
    margin-top: 0.7rem;
    margin-bottom: 0;
  }

  .pg-bytebar-track {
    position: relative;
    height: 30px;
    border-radius: 6px;
    border: 1px dashed #bbb;
    overflow: hidden;
    background: #fff;
  }

  .pg-bytebar-fill {
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, #4a6fa5, #7c9cc7);
    transform: scaleX(0);
    transform-origin: left;
    animation: pg-grow-x 0.8s ease forwards;
    animation-delay: 0.15s;
  }

  @keyframes pg-grow-x {
    to { transform: scaleX(1); }
  }

  .pg-ladder {
    display: flex;
    align-items: flex-end;
    gap: 1.5rem;
    height: 100px;
    padding: 0 0.5rem;
  }

  .pg-ladder-bar {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    height: 100%;
  }

  .pg-ladder-fill {
    width: 100%;
    max-width: 64px;
    border-radius: 4px 4px 0 0;
    background: #4a6fa5;
    transform: scaleY(0);
    transform-origin: bottom;
    animation: pg-grow-y 0.6s ease forwards;
  }

  .pg-ladder-bar:nth-child(1) .pg-ladder-fill { animation-delay: 0s; }
  .pg-ladder-bar:nth-child(2) .pg-ladder-fill { animation-delay: 0.12s; background: #6a8fc0; }
  .pg-ladder-bar:nth-child(3) .pg-ladder-fill { animation-delay: 0.24s; background: #93b3da; }

  @keyframes pg-grow-y {
    to { transform: scaleY(1); }
  }

  .pg-ladder-label {
    font-size: 0.78rem;
    color: #555;
    text-align: center;
    line-height: 1.3;
  }

  .pg-ladder-label strong {
    display: block;
    font-size: 0.85rem;
    color: #111;
  }

  /* Responsive */
  @media (max-width: 600px) {
    .header-row { flex-direction: column; gap: 0.4rem; }
    nav a { margin-left: 0; margin-right: 1rem; }
    nav a:first-child { margin-right: 1rem; }
    .book-grid { grid-template-columns: repeat(2, 1fr); }
    .pg-stat { flex-basis: 40%; }
    .pg-ladder { gap: 0.75rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pg-stat, .pg-bytebar-fill, .pg-ladder-fill {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
