---
import Base from '../layouts/Base.astro';
import listening from '../data/listening.json';
---
<Base title="Listening" page="listening">

  <h2>Podcast episodes</h2>
  <!-- To add an entry, add an object to src/data/listening.json:
       { "title": "...", "podcast": "...", "url": "..." } -->
  {listening.length === 0
    ? <p class="empty-note">Nothing here yet — check back later.</p>
    : (
      <ul>
        {listening.map((item: { title: string; podcast: string; url: string }) => (
          <li>
            <a href={item.url} target="_blank" rel="noopener">{item.title}</a>
            {' — '}{item.podcast}
          </li>
        ))}
      </ul>
    )
  }

</Base>
