---
import Base from '../layouts/Base.astro';
import watching from '../data/watching.json';

interface WatchItem {
  title: string;
  channel: string;
  video_id: string;
  note?: string;
}
---
<Base title="Watching" page="watching">

  <h2>Videos &amp; talks</h2>
  {watching.length === 0
    ? <p class="empty-note">Nothing here yet — check back later.</p>
    : <div class="media-list">
        {(watching as WatchItem[]).map(item => (
          <a class="media-card" href={`https://youtu.be/${item.video_id}`} target="_blank" rel="noopener">
            <img
              class="media-thumb media-thumb--video"
              src={`https://img.youtube.com/vi/${item.video_id}/hqdefault.jpg`}
              alt={item.title}
              loading="lazy"
            />
            <div class="media-info">
              <p class="media-title">{item.title}</p>
              <p class="media-sub">{item.channel}</p>
              {item.note && <p class="media-note">{item.note}</p>}
            </div>
          </a>
        ))}
      </div>
  }

</Base>
